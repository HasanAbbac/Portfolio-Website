# Copy this file to .env and fill it in. Never commit .env.
# Messages from the contact form are delivered to MAIL_TO.
MAIL_TO=hasan.x.abbasi@gmail.com

# Option A (recommended, free, no domain needed): Brevo. Create a free account at https://www.brevo.com, add and verify your
# Gmail address as a sender (Senders, Domains and dedicated IPs), then create an API key (SMTP and API, API keys).
# The sender must be the verified address. Messages arrive in MAIL_TO and replying answers the visitor.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Option B (used only when BREVO_API_KEY is empty): send through SMTP.
# Gmail example: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hasan.x.abbasi@gmail.com
SMTP_PASS=

# Set to true to test the form without sending real email (the message is printed in the terminal).
MAIL_DRY_RUN=false

PORT=3001

# Public address of the site, used at BUILD time for the canonical URL, social previews, sitemap.xml and robots.txt.
# On Vercel this is optional (the production address is used automatically); set it only for a custom domain.
# Example: SITE_URL=https://your-domain.com   (leave empty until you have the live address)
SITE_URL=

# Send HTTPS-only security headers. Defaults to true when NODE_ENV=production, false otherwise.
HTTPS_ONLY=

# --- AI assistant (RAG) ---
# Recommended (free): a Gemini key from https://aistudio.google.com/apikey. Gemini writes the answers from the retrieved
# passages. The model id can change over time; see https://ai.google.dev/gemini-api/docs/models for the current fast model.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
# Optional. With a key, Claude writes the answers from the retrieved passages. Without one, the assistant quotes the
# best-matching passage from your documents. Get a key at https://console.anthropic.com (never commit it).
ANTHROPIC_API_KEY=
# Model for the assistant. The default is claude-opus-5-5; a cheaper model such as claude-haiku-5-5 also works.
CHAT_MODEL=
# Vercel: add GEMINI_API_KEY, BREVO_API_KEY, BREVO_SENDER_EMAIL (and MAIL_TO) under Settings, Environment Variables, then redeploy.
# Folder where the 23 MB embedding model is cached after the first download (default: .model-cache in the project).
RAG_MODEL_CACHE=

# --- Hosting and limits (all optional) ---
# How many reverse proxies sit in front of the server. Render, Railway, Fly etc. use 1 (the default in production).
# Use 0 when the server is reachable directly, so the X-Forwarded-For header cannot be forged to dodge the limits.
TRUST_PROXY=
# Contact form: accepted messages per visitor per window.
CONTACT_LIMIT=5
CONTACT_WINDOW_MINUTES=15
# Assistant: questions per visitor per window, and a shared cap on language-model calls per hour across all visitors
# (past the cap it quotes your documents instead of calling the model).
CHAT_LIMIT=20
CHAT_WINDOW_MINUTES=10
CHAT_LLM_PER_HOUR=300
